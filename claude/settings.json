{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "DesignSync"
    ]
  },
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "dataviz": "off",
    "simplify": "off",
    "code-review": "off",
    "slack-api": "off",
    "block-kit": "off",
    "slack-cli": "off",
    "create-slack-app": "off",
    "gh": "off",
    "gh-stack": "on",
    "docx": "off",
    "pptx": "off",
    "xlsx": "off",
    "pdf": "off",
    "learn": "off",
    "morning": "off",
    "docs": "off",
    "finding-google-skills": "off"
  },
  "enableArtifact": false,
  "outputStyle": "Concise",
  "effortLevel": "medium",
  "tui": "fullscreen",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "editorMode": "normal",
  "vimInsertModeRemaps": {
    "jj": "<Esc>"
  },
  "preferredNotifChannel": "ghostty",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "model": "opus",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "enableWorkflows": false,
  "enabledPlugins": {
    "eli5@claude-community": false,
    "exa@claude-plugins-official": true,
    "pstack@pstack-claude": true,
    "skill-creator@claude-plugins-official": false,
    "slack@claude-plugins-official": false,
    "visual-explainer@visual-explainer-marketplace": true,
    "worktrunk@worktrunk": true,
    "slack-by-salesforce@synced": false,
    "cowork-plugin-management@synced": false
  },
  "extraKnownMarketplaces": {
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      },
      "autoUpdate": true
    },
    "pstack-claude": {
      "source": {
        "source": "github",
        "repo": "michael-denyer/pstack-claude"
      },
      "autoUpdate": true
    },
    "visual-explainer-marketplace": {
      "source": {
        "source": "github",
        "repo": "nicobailon/visual-explainer"
      }
    }
  },
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "320000",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "FORCE_AUTOUPDATE_PLUGINS": "true",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_ENABLE_TASKS": "false"
  }
}
