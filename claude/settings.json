{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "DesignSync"
    ]
  },
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "dataviz": "off",
    "simplify": "off",
    "code-review": "off",
    "slack-api": "off",
    "block-kit": "off",
    "slack-cli": "off",
    "create-slack-app": "off",
    "gh": "off",
    "gh-stack": "on",
    "docx": "off",
    "pptx": "off",
    "xlsx": "off",
    "pdf": "off",
    "learn": "off",
    "morning": "off",
    "docs": "off",
    "finding-google-skills": "off"
  },
  "enableArtifact": false,
  "outputStyle": "Concise",
  "effortLevel": "medium",
  "tui": "fullscreen",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "normal",
  "vimInsertModeRemaps": {
    "jj": "<Esc>"
  },
  "preferredNotifChannel": "ghostty",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "model": "opus",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "enableWorkflows": false,
  "enabledPlugins": {
    "exa@claude-plugins-official": true,
    "pstack@pstack-claude": true,
    "visual-explainer@visual-explainer-marketplace": true,
    "worktrunk@worktrunk": true
  },
  "extraKnownMarketplaces": {
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      },
      "autoUpdate": true
    },
    "pstack-claude": {
      "source": {
        "source": "github",
        "repo": "michael-denyer/pstack-claude"
      },
      "autoUpdate": true
    },
    "visual-explainer-marketplace": {
      "source": {
        "source": "github",
        "repo": "nicobailon/visual-explainer"
      },
      "autoUpdate": true
    }
  },
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "320000",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_ENABLE_TASKS": "false",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5-1",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5"
  }
}
