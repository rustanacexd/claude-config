{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "DesignSync"
    ]
  },
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "dataviz": "off",
    "simplify": "off",
    "code-review": "off",
    "slack-api": "off",
    "block-kit": "off",
    "slack-cli": "off",
    "create-slack-app": "off",
    "gh": "off",
    "gh-stack": "on",
    "docx": "off",
    "pptx": "off",
    "xlsx": "off",
    "pdf": "off",
    "learn": "off",
    "morning": "off",
    "docs": "off",
    "finding-google-skills": "off"
  },
  "enableArtifact": false,
  "outputStyle": "Concise",
  "effortLevel": "high",
  "tui": "fullscreen",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "normal",
  "vimInsertModeRemaps": {
    "jj": "<Esc>"
  },
  "preferredNotifChannel": "ghostty",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "model": "opus",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "enableWorkflows": false,
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": true,
    "exa@claude-plugins-official": true,
    "plannotator-effective-html@effective-html": true,
    "plannotator@plannotator": true,
    "pstack@pstack-claude": true
  },
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "extraKnownMarketplaces": {
    "effective-html": {
      "source": {
        "source": "github",
        "repo": "plannotator/effective-html"
      },
      "autoUpdate": true
    },
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      },
      "autoUpdate": true
    },
    "pstack-claude": {
      "source": {
        "source": "github",
        "repo": "michael-denyer/pstack-claude"
      },
      "autoUpdate": true
    }
  },
  "autoCompactWindow": 400000,
  "env": {
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_ENABLE_TASKS": "false",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5-1",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_SHELL": "/opt/homebrew/bin/bash"
  }
}
