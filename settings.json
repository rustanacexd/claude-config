{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "dataviz": "off",
    "simplify": "off",
    "code-review": "off",
    "slack-api": "off",
    "block-kit": "off",
    "slack-cli": "off",
    "create-slack-app": "off",
    "gh": "on",
    "gh-stack": "on",
    "docx": "off",
    "pptx": "off",
    "xlsx": "off",
    "pdf": "off",
    "learn": "off",
    "morning": "off",
    "docs": "off"
  },
  "enableArtifact": true,
  "outputStyle": "Concise",
  "effortLevel": "medium",
  "advisorModel": "fable",
  "tui": "fullscreen",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "editorMode": "normal",
  "vimInsertModeRemaps": {
    "jj": "<Esc>"
  },
  "preferredNotifChannel": "ghostty",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
